[
  {
    "id": 0,
    "text": "I told you last time about "
  },
  {
    "id": 1,
    "text": "the gateways. "
  },
  {
    "id": 2,
    "text": "Remember?"
  },
  {
    "id": 3,
    "text": "The second Akashic Point leads  "
  },
  {
    "id": 4,
    "text": "to an even stranger place."
  },
  {
    "id": 5,
    "text": "A prison, floating on the sea, "
  },
  {
    "id": 6,
    "text": "shut down long ago. "
  },
  {
    "id": 7,
    "text": ""
  },
  {
    "id": 8,
    "text": "In daylight it's only ruins."
  },
  {
    "id": 9,
    "text": " "
  },
  {
    "id": 10,
    "text": "But when night falls, you could"
  },
  {
    "id": 11,
    "text": "hear a woman's tragic scream."
  },
  {
    "id": 12,
    "text": "A cry so chilling that "
  },
  {
    "id": 13,
    "text": "birds go mad,"
  },
  {
    "id": 14,
    "text": "caking the ocean surface with "
  },
  {
    "id": 15,
    "text": "their dead bodies--"
  },
  {
    "id": 16,
    "text": "drowning themselves to"
  },
  {
    "id": 17,
    "text": "escape her cry."
  },
  {
    "id": 18,
    "text": "Not all the island's prisoners "
  },
  {
    "id": 19,
    "text": "have been moved."
  },
  {
    "id": 20,
    "text": "You don't have to believe me, "
  },
  {
    "id": 21,
    "text": "you can believe what you want."
  }
]