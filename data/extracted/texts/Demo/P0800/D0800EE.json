[
  {
    "id": 0,
    "text": "Sorry for interrupting "
  },
  {
    "id": 1,
    "text": "your time abroad."
  },
  {
    "id": 2,
    "text": "But will you fight?  "
  },
  {
    "id": 3,
    "text": "For Travis?"
  },
  {
    "id": 4,
    "text": "Sure... I'm eager to kill so "
  },
  {
    "id": 5,
    "text": "hurry with the details."
  },
  {
    "id": 6,
    "text": "Straight to the point. "
  },
  {
    "id": 7,
    "text": "I like that."
  },
  {
    "id": 8,
    "text": "Can you handle 2 of "
  },
  {
    "id": 9,
    "text": "our top ten?"
  },
  {
    "id": 10,
    "text": "Only two?  That's nothing."
  },
  {
    "id": 11,
    "text": "Why don't I just take'em all?"
  },
  {
    "id": 12,
    "text": "You've grown confident. "
  },
  {
    "id": 13,
    "text": "Yeah. But not over-confident."
  },
  {
    "id": 14,
    "text": "Unlike you,"
  },
  {
    "id": 15,
    "text": "I can see myself objectively."
  },
  {
    "id": 16,
    "text": "Creepy little girl."
  },
  {
    "id": 17,
    "text": "Don't forget your promise. Double cross "
  },
  {
    "id": 18,
    "text": "me and you're dead."
  },
  {
    "id": 19,
    "text": "You can not kill me, silly."
  },
  {
    "id": 20,
    "text": "You're not worth the stain"
  },
  {
    "id": 21,
    "text": "on my blade."
  }
]