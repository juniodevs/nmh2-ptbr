[
  {
    "id": 0,
    "text": "She was called \"The Goddess of Death\"."
  },
  {
    "id": 1,
    "text": "With sickle in hand, "
  },
  {
    "id": 2,
    "text": "She would chant her requiem."
  },
  {
    "id": 3,
    "text": "If you heard it, "
  },
  {
    "id": 4,
    "text": "odds were you'd just drawn"
  },
  {
    "id": 5,
    "text": "your last breath."
  },
  {
    "id": 6,
    "text": "The mere sound of her voice "
  },
  {
    "id": 7,
    "text": "would put ice in your veins."
  },
  {
    "id": 8,
    "text": "I know..."
  },
  {
    "id": 9,
    "text": "I heard it myself once, "
  },
  {
    "id": 10,
    "text": "from a hundred yards away."
  },
  {
    "id": 11,
    "text": "The moment it touched my ear,"
  },
  {
    "id": 12,
    "text": "I passed out for an entire week."
  },
  {
    "id": 13,
    "text": "If I'd heard it up close, "
  },
  {
    "id": 14,
    "text": "I can scarcely imagine..."
  },
  {
    "id": 15,
    "text": "Forget it--"
  },
  {
    "id": 16,
    "text": "let's talk about happier things."
  }
]